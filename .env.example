# Copy to .env in the repository root. Keep provider credentials local.
PRESENTATION_PROVIDER=deterministic

# See backend/config.example.env for OpenAI and Copilot settings.

# Optional local PostgreSQL prototype, not a production authentication mode.
# The preview:shared launcher configures these without changing .env.
# REVIEW_STORE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
