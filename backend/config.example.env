# Copy these values into a local root .env. Never commit credentials.
PRESENTATION_PROVIDER=openai
OPENAI_API_KEY=replace-with-local-openai-key
OPENAI_MODEL=gpt-5-mini

# Alternative provider once tenant access exists:
# PRESENTATION_PROVIDER=copilot
# COPILOT_ACCESS_TOKEN=replace-with-delegated-graph-token

# Explicit offline mode:
# PRESENTATION_PROVIDER=deterministic
